{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": ".",
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "audits/**/*.ts",
    "config/**/*.ts",
    "crawlers/**/*.ts",
    "fixtures/**/*.ts",
    "global-setup.ts",
    "global-teardown.ts",
    "pages/**/*.ts",
    "reporters/**/*.ts",
    "tests/**/*.ts",
    "utils/**/*.ts",
    "validators/**/*.ts",
    "playwright.config.ts",
    "playwright.unit.config.ts"
  ],
  "exclude": ["node_modules", "dist", "reports", "screenshots", "traces", "logs"]
}

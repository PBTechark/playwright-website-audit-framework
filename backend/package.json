    "express": "^4.22.3"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.6",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}

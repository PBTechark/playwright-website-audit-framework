{
  "name": "website-audit-backend",
  "version": "1.0.0",
  "description": "API and background job manager that runs the Playwright website audit engine for the dashboard.",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "dependencies": {
    "archiver": "^8.0.0",

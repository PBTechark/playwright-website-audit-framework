TARGETS_CSV=test-data/audit-targets.csv
MAX_PAGES=60
MAX_DEPTH=4
API_VALIDATION_CONCURRENCY=8
LINK_CHECK_LIMIT_PER_PAGE=150
SCREENSHOT_MODE=on
AUDIT_FAIL_ON_SEVERITY=Medium
REPORT_HISTORY_RETENTION=12

# Server sizing, tuned for 2 CPU cores / 4 GB RAM / 2 GB swap.
# Measured there: ~31 s per page per viewport with 2 workers, so ~23 pages/hour across all 5
# viewports, peak ~1.5 GB while testing and ~2.7 GB while building reports for 200 pages.
# One browser per worker; keep workers equal to CPU cores. Also the number of sites crawled at once.
AUDIT_WORKERS=2
# Per page x viewport. A test that times out loses that page's results.
TEST_TIMEOUT_MS=240000
# Whole run: 3 hours fits ~65 pages at all 5 viewports.
GLOBAL_TIMEOUT_MS=10800000
# Largest audit the dashboard accepts; keep it within GLOBAL_TIMEOUT_MS at ~23 pages/hour.
AUDIT_MAX_PAGES_LIMIT=60
# Heap for the engine started by the dashboard (npm run audit sets the same value).
AUDIT_ENGINE_HEAP_MB=2560
# Findings fail tests by design, so retries only repeat work.
TEST_RETRIES=0
# Playwright trace/video recording: off, on, retain-on-failure or on-first-retry.
# Costs ~30% run time and ~30 MB of disk per page with findings; enable only to debug the engine.
TRACE_MODE=off
VIDEO_MODE=off

# Dashboard sign-in used by backend/. Set real values in .env.
# npm run share (public ngrok URL) requires a password of at least 12 characters.
DASHBOARD_USER_ID=
DASHBOARD_PASSWORD=
# Optional: your free static ngrok domain, so the shared URL stays the same between runs.
NGROK_DOMAIN=
